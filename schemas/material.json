        "stress_amplitude"
      ],
      "title": "SNPoint",
      "type": "object"
    },
    "StrengthFactors": {
      "additionalProperties": false,
      "description": "Strength multipliers by loading direction relative to the build direction.",
      "properties": {
        "in_layer": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "In Layer",
          "type": "number"
        },
        "interlayer": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Interlayer",
          "type": "number"
        }
      },
      "required": [
        "in_layer",
        "interlayer"
      ],
      "title": "StrengthFactors",
      "type": "object"
    },
