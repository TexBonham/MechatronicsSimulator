    "ExpansionSpread": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Max",
          "type": "string"
        },
        "min": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Min",
          "type": "string"
        },
        "temperature_dependence": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TemperaturePoint"
              },
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Dependence"
        },
        "typ": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Typ",
          "type": "string"
        }
      },
      "required": [
        "min",
        "typ",
        "max"
      ],
      "title": "ExpansionSpread",
      "type": "object"
    },
