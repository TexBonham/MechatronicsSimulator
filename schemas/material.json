    "PrintedProcess": {
      "additionalProperties": false,
      "properties": {
        "build_direction": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Build Direction",
          "type": "array"
        },
        "infill": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Infill",
          "type": "string"
        },
        "infill_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Infill Pattern"
        },
        "kind": {
          "const": "printed",
          "title": "Kind",
          "type": "string"
        },
        "layer_height": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Layer Height",
          "type": "string"
        },
        "strength_factors": {
          "$ref": "#/$defs/StrengthFactors"
        },
        "walls": {
          "minimum": 1,
          "title": "Walls",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "build_direction",
        "layer_height",
        "walls",
        "infill",
        "strength_factors"
      ],
