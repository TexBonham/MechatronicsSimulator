      "additionalProperties": false,
      "properties": {
        "cycles": {
          "minimum": 1.0,
          "title": "Cycles",
          "type": "number"
        },
        "stress_amplitude": {
          "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
          "title": "Stress Amplitude",
          "type": "string"
        }
