  "$id": "material.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of a file under `mechsim/materials/data/`.",
  "properties": {
    "density": {
      "$ref": "#/$defs/PositiveDensity"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "family": {
      "enum": [
        "aluminium",
        "steel",
        "polymer",
        "other"
      ],
      "title": "Family",
      "type": "string"
    },
    "grade": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grade"
    },
    "max_service_temperature": {
      "$ref": "#/$defs/PositiveTemperature"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "placeholder": {
      "title": "Placeholder",
      "type": "boolean"
    },
    "poissons_ratio": {
      "$ref": "#/$defs/PoissonSpread"
    },
    "process": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "machined": "#/$defs/MachinedProcess",
              "molded": "#/$defs/MoldedProcess",
              "printed": "#/$defs/PrintedProcess"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PrintedProcess"
            },
            {
              "$ref": "#/$defs/MachinedProcess"
            },
            {
              "$ref": "#/$defs/MoldedProcess"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Process"
    },
    "shear_strength": {
      "$ref": "#/$defs/PositivePressure"
    },
    "sn_curve": {
      "items": {
        "$ref": "#/$defs/SNPoint"
      },
      "minItems": 2,
      "title": "Sn Curve",
      "type": "array"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "specific_heat": {
      "$ref": "#/$defs/PositiveSpecificHeat"
    },
    "thermal_conductivity": {
      "$ref": "#/$defs/PositiveConductivity"
    },
    "thermal_expansion": {
      "$ref": "#/$defs/ExpansionSpread"
    },
    "ultimate_strength": {
      "$ref": "#/$defs/PositivePressure"
    },
    "wide_spread_default": {
      "title": "Wide Spread Default",
      "type": "boolean"
    },
    "yield_strength": {
      "$ref": "#/$defs/PositivePressure"
    },
    "youngs_modulus": {
      "$ref": "#/$defs/PositivePressure"
    }
  },
  "required": [
    "name",
    "family",
    "source",
    "placeholder",
    "wide_spread_default",
    "density",
    "youngs_modulus",
    "poissons_ratio",
    "yield_strength",
    "ultimate_strength",
    "shear_strength",
    "sn_curve",
    "thermal_conductivity",
    "specific_heat",
    "thermal_expansion",
    "max_service_temperature"
  ],
  "title": "MaterialFile",
  "type": "object"
}
