{
  "$defs": {
    "DesignRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "DesignRef",
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "case": {
          "pattern": "^[A-Z][A-Z0-9_]*[0-9]+$",
          "title": "Case",
          "type": "string"
        },
        "criterion": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Criterion",
          "type": "string"
        },
        "limit": {
          "description": "the criterion's limit as the case states it",
          "minLength": 1,
          "title": "Limit",
          "type": "string"
        },
        "measured": {
          "anyOf": [
            {
              "pattern": "^\\s*[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?(\\s+\\S.*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured"
        },
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_run",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "worst_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worst Time"
        }
      },
      "required": [
        "case",
        "criterion",
        "status",
        "limit"
      ],
      "title": "Entry",
      "type": "object"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "description": "Which archive produced an entry: its run id and hashes (L8, D3).",
      "properties": {
        "archive_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "case_hash": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Case Hash",
          "type": "string"
        },
        "design_hash": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Design Hash",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "archive_sha256",
        "design_hash",
        "case_hash"
      ],
      "title": "RunIdentity",
      "type": "object"
    }
  },
  "$id": "baseline.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Root of a suite's `baseline.yaml`.",
  "properties": {
    "design": {
      "$ref": "#/$defs/DesignRef"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "suite": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Suite",
      "type": "string"
    }
  },
  "required": [
    "design",
    "suite",
    "entries"
  ],
  "title": "BaselineFile",
  "type": "object"
}
