<mujoco model="slider">
  <compiler angle="radian" autolimits="false" inertiafromgeom="false" balanceinertia="false" boundmass="0" boundinertia="0" />
  <option timestep="0.001" gravity="0 0 0" integrator="implicitfast" iterations="50" />
  <worldbody>
    <body name="block" pos="0 0 0" quat="1.0 0 0 0">
      <inertial pos="0 0 0" mass="1.0" fullinertia="0.0001 0.0001 0.0001 0 0 0" />
      <joint name="slide" type="slide" axis="1.0 0 0" />
    </body>
  </worldbody>
  <equality>
    <joint name="slide.drive" joint1="slide" polycoef="0 0 0 0 0" active="false" solref="-1 -1" solimp="0.0001 0.0001 0.001 0.5 2" />
  </equality>
  <custom>
    <text name="mechsim:elements" data="body joint.prismatic" />
    <text name="mechsim:bodies" data="block" />
    <text name="mechsim:joints" data="slide:prismatic" />
    <text name="mechsim:drives" data="slide" />
  </custom>
</mujoco>
