{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git grep:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(uv run mypy:*)",
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(ctest:*)",
      "Bash(python3 tools/check_imports.py:*)",
      "Bash(uv run python tools/check_imports.py:*)",
      "Bash(git push -u origin round/*)",
      "Bash(git push origin round/*)",
      "Bash(git push -u origin wip/*)",
      "Bash(git push origin wip/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --locked python tools/hooks/import_boundary_hook.py"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --locked python tools/hooks/yaml_check_hook.py"
          }
        ]
      }
    ]
  }
}
