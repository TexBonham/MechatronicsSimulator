{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "host",
            "displayName": "Host build for native mode, with tests",
            "inherits": "base",
            "cacheVariables": {
                "MECHSIM_FW_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "arm-none-eabi",
            "displayName": "Cortex-M target build (placeholder core, chip not set)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
            "cacheVariables": {
                "MECHSIM_FW_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host",
            "configurePreset": "host",
            "jobs": 2
        },
        {
            "name": "arm-none-eabi",
            "configurePreset": "arm-none-eabi",
            "jobs": 2
        }
    ],
    "testPresets": [
        {
            "name": "host",
            "configurePreset": "host",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 2
            }
        }
    ]
}
