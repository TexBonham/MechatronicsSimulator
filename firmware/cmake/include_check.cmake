# Invariant 8, FW-005, FW-006: application code includes the board header, the freestanding C headers (C11 4p6) and
# its own headers under APP_ROOT, nothing else. Run as:
#   cmake -DAPP_ROOT=<dir> -DBOARD_HEADER=<board_interface/mechsim_board.h> [-DFILES=<a;b>] [-DBOARD_ROOT=<dir>] -P <this>
cmake_minimum_required(VERSION 3.28)

if(NOT DEFINED APP_ROOT)
    message(FATAL_ERROR "firmware_include_check: APP_ROOT is not set")
endif()
if(NOT DEFINED BOARD_HEADER OR NOT EXISTS "${BOARD_HEADER}")
    message(FATAL_ERROR "firmware_include_check: BOARD_HEADER does not name the board_interface file")
endif()
get_filename_component(app_root "${APP_ROOT}" REALPATH)
get_filename_component(board_header "${BOARD_HEADER}" REALPATH)

set(freestanding_headers
    float.h iso646.h limits.h stdalign.h stdarg.h stdbool.h stddef.h stdint.h stdnoreturn.h)

if(DEFINED FILES)
    set(scan_files ${FILES})
else()
    file(GLOB_RECURSE scan_files LIST_DIRECTORIES false "${app_root}/*.c" "${app_root}/*.h")
endif()

set(failures "")

if(DEFINED BOARD_ROOT)
    file(GLOB board_loose LIST_DIRECTORIES false "${BOARD_ROOT}/*.c" "${BOARD_ROOT}/*.h")
    foreach(loose IN LISTS board_loose)
        list(APPEND failures "${loose}: source outside firmware/board/<chip>/ (C5)")
    endforeach()
endif()

foreach(source IN LISTS scan_files)
    get_filename_component(source_name "${source}" NAME)
    if(source_name STREQUAL "mechsim_board.h")
        list(APPEND failures "${source}: shadows board_interface/mechsim_board.h")
    endif()
    get_filename_component(source_dir "${source}" DIRECTORY)
    file(STRINGS "${source}" lines)
    set(line_number 0)
    foreach(line IN LISTS lines)
        math(EXPR line_number "${line_number} + 1")
        if(NOT line MATCHES "^[ \t]*#[ \t]*include")
            continue()
        endif()
        set(delimiter "")
        if(line MATCHES "^[ \t]*#[ \t]*include[ \t]*<([^<>\"]+)>[ \t]*(//.*|/\\*.*)?$")
            set(delimiter "<")
            set(closing ">")
            set(header "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^[ \t]*#[ \t]*include[ \t]*\"([^<>\"]+)\"[ \t]*(//.*|/\\*.*)?$")
            set(delimiter "\"")
            set(closing "\"")
            set(header "${CMAKE_MATCH_1}")
        endif()
        if(delimiter STREQUAL "")
            list(APPEND failures "${source}:${line_number}: rejected include form '${line}'")
            continue()
        endif()
        if(header STREQUAL "mechsim_board.h")
            set(board_ok TRUE)
            if(delimiter STREQUAL "\"" AND EXISTS "${source_dir}/mechsim_board.h")
                get_filename_component(local_board "${source_dir}/mechsim_board.h" REALPATH)
                if(NOT local_board STREQUAL board_header)
                    set(board_ok FALSE)
                endif()
            endif()
            if(NOT board_ok)
                list(APPEND failures
                    "${source}:${line_number}: mechsim_board.h resolves to ${local_board}, not ${board_header}")
            endif()
            continue()
        endif()
        list(FIND freestanding_headers "${header}" allowed_index)
        if(NOT allowed_index EQUAL -1)
            continue()
        endif()
        set(local_ok FALSE)
        if(delimiter STREQUAL "\"" AND NOT header MATCHES "\\.\\." AND NOT IS_ABSOLUTE "${header}")
            get_filename_component(resolved "${source_dir}/${header}" REALPATH)
            string(FIND "${resolved}" "${app_root}/" root_position)
            if(EXISTS "${resolved}" AND root_position EQUAL 0)
                set(local_ok TRUE)
            endif()
        endif()
        if(NOT local_ok)
            list(APPEND failures "${source}:${line_number}: rejected include ${delimiter}${header}${closing}")
        endif()
    endforeach()
endforeach()

if(failures)
    list(JOIN failures "\n  " report)
    message(FATAL_ERROR "firmware_include_check failed (invariant 8):\n  ${report}")
endif()
list(LENGTH scan_files scanned)
message(STATUS "firmware_include_check: ${scanned} files clean")
